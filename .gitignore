# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# movie list and admin password, kept on the server only
/tools/movie-tracker/config.json
/tools/movie-tracker/movies.json
/tools/movie-tracker/movies.json.bak
/tools/movie-tracker/movies.json.tmp
/tools/movie-tracker/douban_session.json
/tools/movie-tracker/douban_pending.json
/tools/movie-tracker/__pycache__/
/tools/movie-tracker/config.json.tmp

# FileDrop runtime data is kept on the server.
/tools/filedrop/node_modules/
/tools/filedrop/uploads/
/tools/filedrop/usage.json*
/tools/deploy-personal-tools/*.zip
/tools/deploy-personal-tools/*.log

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Visitor map runtime data stays on the server.
/tools/visitor-map/data/
/tools/visitor-map/__pycache__/
/tools/visitor-map/*.zip

# Reminder service: never publish credentials, live data or local runtimes.
/tools/reminder-tool/.venv/
/tools/reminder-tool/data/
/tools/reminder-tool/__pycache__/
/tools/reminder-tool/auth.json
/tools/reminder-tool/*.zip
/tools/reminder-tool/.preview*
