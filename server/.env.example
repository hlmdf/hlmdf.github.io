# 复制成 .env 后再改：cp .env.example .env
# 访问令牌：随便生成一串长随机字符串，前端页面里会填同一串
# 生成方法：openssl rand -hex 24
API_TOKEN=change-me-to-a-long-random-string

# 允许的来源，多个用英文逗号分隔。填你的站点域名最安全；
# 填 * 表示不限制（令牌泄露时风险更高）
ALLOWED_ORIGINS=https://your-domain.com

# 单文件大小上限（MB）
MAX_MB=100

# 注册码：网页上注册账号时要填这串。留空表示任何人都能注册
# （那样登录就无限次了，等于没有游客限制，一般不要留空）
SIGNUP_CODE=change-me

# 游客每天的免费次数
FREE_NORMAL=100
FREE_HEAVY=10
