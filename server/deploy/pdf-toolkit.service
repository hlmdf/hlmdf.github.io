[Unit]
Description=PDF toolkit API
After=network.target

[Service]
Type=simple
User=pdftool
Group=pdftool
WorkingDirectory=/opt/pdf-toolkit
EnvironmentFile=/opt/pdf-toolkit/.env
Environment=HOME=/var/lib/pdf-toolkit
ExecStart=/opt/pdf-toolkit/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8013
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
