[Unit]
Description=Homepage air radar proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=air-radar
Group=air-radar
WorkingDirectory=/opt/air-radar
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/air-radar/server.py --host 127.0.0.1 --port 8011
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
